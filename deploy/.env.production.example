RELEASE_TAG=v0.1.0
API_IMAGE=ghcr.io/katsuotz/generate-kit/api
WORKER_IMAGE=ghcr.io/katsuotz/generate-kit/worker
FRONTEND_IMAGE=ghcr.io/katsuotz/generate-kit/frontend

POSTGRES_DB=cvworkbench
POSTGRES_USER=cvworkbench
POSTGRES_PASSWORD=replace-with-a-random-password
API_PORT=18732
FRONTEND_PORT=18731

FRONTEND_ORIGIN=https://cvworkbench.com
LATEX_COMPILER_ENABLED=true
LATEX_COMPILER_PATH=xelatex
COMPILE_TIMEOUT_SECONDS=30
SESSION_TTL_SECONDS=2592000
COOKIE_SECURE=true
# Set these values from the Google Cloud OAuth web application client.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://cvworkbench.com/api/v1/auth/google/callback
# Set the LinkedIn client values to enable LinkedIn sign-in. Keep the secret server-side.
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REDIRECT_URI=https://cvworkbench.com/api/v1/auth/linkedin/callback
# Basic profile import uses the OIDC userinfo endpoint. Full-history import requires additional
# LinkedIn-approved scopes and a corresponding approved profile endpoint.
# LINKEDIN_IMPORT_SCOPES=openid profile email
# LINKEDIN_IMPORT_PROFILE_URL=https://api.linkedin.com/v2/userinfo
