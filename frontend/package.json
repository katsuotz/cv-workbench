    "jsdom": "^25.0.1",
    "oxfmt": "^0.60.0",
    "oxlint": "1.74.0",
    "postcss": "^8.4.49",
    "svelte": "5.16.0",
    "svelte-check": "^4.1.3",
    "tailwindcss": "^4.3.3",
